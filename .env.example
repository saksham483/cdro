# Application Environment (development / production)
APP_ENV=development

# Database Configuration (PostgreSQL in production, SQLite fallback in local standalone dev)
DATABASE_URL=postgresql://cdro:cdro_password@localhost:5432/cdro_db
# For quick local standalone testing without postgres, set:
# DATABASE_URL=sqlite:///cdro.db

# Security & Secrets
SECRET_KEY=cdro-super-secret-key-change-in-production-38472910
JWT_SECRET_KEY=cdro-jwt-secret-key-change-in-production-19283746
INTERNAL_SECRET=demoapp-internal-auth-token-48291

# DemoApp Target Endpoint
DEMOAPP_URL=http://localhost:5001

# Health Monitoring & Failure Detection Settings
HEALTH_CHECK_INTERVAL_SECONDS=5
HEALTH_FAILURE_THRESHOLD=3

# Backup Orchestration Settings
BACKUP_INTERVAL_SECONDS=300
BACKUP_RETENTION_COUNT=10

# Recovery & DR SLA Targets
RECOVERY_TIMEOUT_SECONDS=120
RTO_TARGET_SECONDS=60

# Storage Backend ('local' or 's3')
STORAGE_BACKEND=local
LOCAL_BACKUP_PATH=storage/backups
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Notification Backend ('console' or 'sns')
NOTIFICATION_BACKEND=console
SNS_TOPIC_ARN=
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Automation Flags
RUN_BACKGROUND_WORKERS=true
